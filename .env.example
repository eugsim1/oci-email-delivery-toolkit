# Read the regional public SMTP endpoint from:
# OCI Console > Developer Services > Application Integration > Email Delivery > Configuration
OCI_SMTP_HOST=smtp.email.eu-frankfurt-1.oci.oraclecloud.com
OCI_SMTP_PORT=465
OCI_SMTP_MODE=tls

# Oracle-generated SMTP credentials. These are not the OCI Console password.
OCI_SMTP_USERNAME=
OCI_SMTP_PASSWORD=

# The From address must match an approved sender, or a DKIM-enabled approved domain.
OCI_EMAIL_FROM=no-reply@example.com
OCI_EMAIL_TO=recipient@example.net
OCI_EMAIL_CC=
OCI_EMAIL_SUBJECT=OCI Email Delivery test
OCI_EMAIL_TEXT=Hello from OCI Email Delivery.
OCI_EMAIL_HTML=

# Optional Go duration, for example 15s or 1m.
OCI_SMTP_TIMEOUT=30s
